# ---------------------------------------------------------------------------
# gta6-news-bot configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Application ID, a.k.a. Client ID. Developer Portal -> your app ->
# General Information -> APPLICATION ID. ~19 digits.
# This is NOT a secret (it is visible in every invite link). Only used to build
# the invite URL via `python -m src.main invite-url`.
DISCORD_CLIENT_ID=

# Bot token (NOT a webhook URL, and NOT the "Client Secret"). A bot token is
# required because AutoMod configuration lives on
# /guilds/{id}/auto-moderation/rules and needs MANAGE_GUILD, which a webhook
# token can never reach.
# Developer Portal -> Bot -> Reset Token. SECRET. Shown only once.
DISCORD_BOT_TOKEN=

# Channel the digest is posted to.
DISCORD_NEWS_CHANNEL_ID=

# Opt-in role pinged by INSTANT alerts only. Leave blank to never ping.
# Set the role to "not mentionable" in Discord and grant the bot
# MENTION_EVERYONE only in the news channel — then the bot can ping it and
# no member can, anywhere.
DISCORD_NEWS_ROLE_ID=

# Where dry-run output goes when --to-dm is used (your own user ID).
DISCORD_OPERATOR_USER_ID=

# --- Scheduling ------------------------------------------------------------
# Local hour (0-23) at or after which the daily digest may post.
# 18 is deliberate: Hungary's DST transitions happen 02:00-03:00, so 18:00
# local exists exactly once every day of the year. Do NOT move this into the
# 02:00-03:00 window or the once-per-local-date guarantee breaks.
DIGEST_HOUR=18

# Minimum items required before a digest is posted at all.
# 0 is deliberate: the EMPTY digest is the heartbeat. It carries the feed-health
# line, so a quiet news day and a totally broken bot look different in the
# channel. Set above 0 only if you would rather have silence than that signal.
DIGEST_MIN_ITEMS=0

# Max entries in one digest.
DIGEST_MAX_ITEMS=8

# --- Safety ----------------------------------------------------------------
# Master switch. When false, nothing is ever POSTed to Discord.
POSTING_ENABLED=false

# Set automatically to true by the bot after a fatal Discord auth error
# (401/403). Clear it manually after fixing the token. This exists because
# 10,000 invalid requests in 10 minutes earns a Cloudflare IP ban, which on a
# residential connection takes the whole household off Discord.
DISCORD_KILL_SWITCH=false

# --- Anthropic credentials -------------------------------------------------
# Needed only when LLM_CURATION_ENABLED=true (see the LLM section below).
ANTHROPIC_API_KEY=

# --- Polling ---------------------------------------------------------------
# Contact URL advertised in the User-Agent so feed owners can reach you.
BOT_CONTACT_URL=https://github.com/your-name/gta6-news-bot

# Default seconds between requests to the SAME domain.
POLITENESS_DELAY_SECONDS=5

# Consecutive failures before a feed is reported unhealthy in the digest.
FEED_FAILURE_ALERT_THRESHOLD=3

# --- Retention -------------------------------------------------------------
# Held items wait for corroboration that may never come. Without a TTL the queue
# only grows, and a three-week-old unconfirmed rumour stays eligible for tonight
# digest - so a channel whose promise is "today" publishes last month as news.
HELD_TTL_DAYS=4

# Unsent items too old to present as news. The 3-day gate in feeds.py only
# filters at INGEST; this bounds what is already stored.
UNSENT_TTL_DAYS=5

# --- LLM curation ------------------------------------------------------------
# Off by default. When on, Claude clusters same-story items that lexical overlap
# provably cannot merge, labels credibility with the nuance the keyword cap lacks,
# ranks, and summarises. ANY failure falls back to the heuristic digest.
LLM_CURATION_ENABLED=false

# Default is the strongest model, deliberately: cost is your call, not the code's.
# claude-sonnet-5 ($2/$10 per Mtok) or claude-haiku-4-5 ($1/$5) are cheaper.
# claude-opus-5 is $5/$25. At one call a day the difference is cents either way.
LLM_DIGEST_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Not sent to Haiku, which rejects it.
LLM_EFFORT=high

# --- Web edition ------------------------------------------------------------
# PUBLIC url of the web edition. Leave EMPTY until it is hosted somewhere your
# members can actually open without logging in. A claude.ai artifact is NOT
# suitable: those are private by default and sit behind claude.ai auth, so a
# Discord member clicking it gets nothing.
# Regenerate with: python -m src.main build-web
DIGEST_WEB_URL=

# --- Web edition deploy -------------------------------------------------------
# web/index.html is ONE self-contained static file, so any static host serves it.
# The deploy step is config, not code: switching hosts is a one-line change here.
#
# Both hosts at once (what this deployment uses). Cloudflare is what the
# digest links to; GitHub Pages is the standby, so an expired Cloudflare
# token leaves a current page up instead of a dead link in Discord.
# Succeeds if at least one host published.
#   WEB_DEPLOY_CMD=python tools/publish_web.py
#   GTA6_PUBLISH_TARGETS=github,cloudflare   (optional; both by default)
#   CF_PAGES_PROJECT=gta6-news               (optional)
#
# GitHub Pages alone -- no account beyond the one you already push with,
# and no interactive login, so it is safe under Task Scheduler:
#   WEB_DEPLOY_CMD=python tools/deploy_pages.py
#
# Cloudflare Pages (run `npx wrangler login` once first):
#   WEB_DEPLOY_CMD=npx --yes wrangler@latest pages deploy web --project-name=gta6-news --commit-dirty=true
#
# Your own server later, over SSH:
#   WEB_DEPLOY_CMD=scp web/index.html user@yourserver:/var/www/gta6/index.html
#
WEB_DEPLOY_CMD=

# --- Breakout alerts -------------------------------------------------------
# Instant alerts only cover first-party sources (two live feeds), so a huge
# story broken by the press waited for the 18:00 digest -- up to a day. A
# breakout alert fires when this many DISTINCT outlets carry the same story,
# on the reasoning that broad corroboration is itself the news.
#
# Set BREAKOUT_MIN_OUTLETS=0 to turn the feature off entirely.
#
# Guards, all deliberate: a real publisher URL is required (a Google News
# redirect lands on a consent wall, which is not something to push to a
# phone); the channel is the rate limiter rather than a local counter; and if
# the rate limit cannot be verified the bot declines to send.
BREAKOUT_MIN_OUTLETS=6
BREAKOUT_WINDOW_HOURS=24
BREAKOUT_MAX_PER_DAY=3
BREAKOUT_COOLDOWN_MINUTES=60

# --- Staying in step with the repo ------------------------------------------
# An install is a `git clone`, so upstream fixes reach every deployment without
# anyone logging into a server. Each run fast-forwards to origin/main before
# doing any work; the pulled code takes effect on the NEXT cycle, so at most 15
# minutes behind on the default schedule.
#
# It refuses to do anything surprising: it skips when the working tree has local
# modifications, when the branch has diverged (--ff-only is the whole policy, so
# it can never merge, rebase or discard a commit), and when the directory is not
# a git checkout at all. .env is gitignored and the database lives outside the
# repo, so neither is ever touched.
#
# Be aware of what this means: the deployment executes whatever is on
# origin/main, so the repo owner's GitHub account is a production credential for
# every install. Set AUTO_UPDATE=false on anything that should not follow head.
AUTO_UPDATE=true
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_INTERVAL_S=3600

# --- Dead-man switch --------------------------------------------------------
# The only monitoring that survives the bot being DEAD. The log, the exit code
# and the operator alerts posted to Discord all require the bot to RUN in order
# to report anything; a process that never starts produces perfect silence, and
# silence looks exactly like a quiet news day.
#
# Create a check at healthchecks.io (free), period 20 min, grace 40 min. The bot
# GETs this URL at the end of each run, and <url>/fail when the run had errors.
HEALTHCHECK_URL=
